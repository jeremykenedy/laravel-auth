{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jeremykenedy/laravel-auth",
    "type": "project",
    "description": "Laravel Authentication Application. A thin shell assembling 21 composable packages.",
    "keywords": [
        "framework",
        "laravel",
        "authentication",
        "modular"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel-ui-kit"
        },
        {
            "type": "path",
            "url": "packages/laravel-ip-capture"
        },
        {
            "type": "path",
            "url": "packages/laravel-captcha"
        },
        {
            "type": "path",
            "url": "packages/laravel-profiles"
        },
        {
            "type": "path",
            "url": "packages/laravel-socialite-kit"
        },
        {
            "type": "path",
            "url": "packages/laravel-themes"
        },
        {
            "type": "path",
            "url": "packages/laravel-toast"
        },
        {
            "type": "path",
            "url": "packages/laravel-notifications"
        },
        {
            "type": "path",
            "url": "packages/laravel-chat"
        },
        {
            "type": "path",
            "url": "packages/laravel-observability"
        },
        {
            "type": "path",
            "url": "packages/laravel-auth-api"
        },
        {
            "type": "path",
            "url": "packages/laravel-face-auth"
        },
        {
            "type": "path",
            "url": "packages/laravel-native-kit"
        },
        {
            "type": "path",
            "url": "packages/laravel-roles"
        },
        {
            "type": "path",
            "url": "packages/laravel2step"
        },
        {
            "type": "path",
            "url": "packages/laravel-logger"
        },
        {
            "type": "path",
            "url": "packages/laravel-blocker"
        },
        {
            "type": "path",
            "url": "packages/laravel-exception-notifier"
        },
        {
            "type": "path",
            "url": "packages/laravel-phpinfo"
        },
        {
            "type": "path",
            "url": "packages/laravel-email-database-log"
        },
        {
            "type": "path",
            "url": "packages/laravel-users"
        },
        {
            "type": "path",
            "url": "packages/laravel-seedster"
        },
        {
            "type": "path",
            "url": "packages/laravel-posts"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.2",
        "jenssegers/agent": "^2.6",
        "jeremykenedy/laravel-auth-api": "@dev",
        "jeremykenedy/laravel-blocker": "@dev",
        "jeremykenedy/laravel-captcha": "@dev",
        "jeremykenedy/laravel-chat": "@dev",
        "jeremykenedy/laravel-email-database-log": "@dev",
        "jeremykenedy/laravel-exception-notifier": "@dev",
        "jeremykenedy/laravel-face-auth": "@dev",
        "jeremykenedy/laravel-ip-capture": "@dev",
        "jeremykenedy/laravel-logger": "@dev",
        "jeremykenedy/laravel-native-kit": "@dev",
        "jeremykenedy/laravel-posts": "@dev",
        "jeremykenedy/laravel-notifications": "@dev",
        "jeremykenedy/laravel-observability": "@dev",
        "jeremykenedy/laravel-phpinfo": "@dev",
        "jeremykenedy/laravel-profiles": "@dev",
        "jeremykenedy/laravel-roles": "@dev",
        "jeremykenedy/laravel-seedster": "@dev",
        "jeremykenedy/laravel-socialite-kit": "@dev",
        "jeremykenedy/laravel-themes": "@dev",
        "jeremykenedy/laravel-toast": "@dev",
        "jeremykenedy/laravel-ui-kit": "@dev",
        "jeremykenedy/laravel-users": "@dev",
        "jeremykenedy/laravel2step": "@dev",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.2",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.0",
        "nesbot/carbon": "^3.8",
        "predis/predis": "^2.1",
        "spatie/laravel-html": "^3.12"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.1",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opcodesio/log-viewer": "^3.24",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "docker:composer": "docker compose run --rm app composer",
        "docker:artisan": "docker compose run --rm app php artisan",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "fresh": [
            "@php artisan migrate:fresh --seed --ansi",
            "@php artisan view:clear --ansi",
            "@php artisan config:clear --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
