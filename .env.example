APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PROJECT_VERSION=13

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Docker Compose (docker-compose.yml): the app service sets DB_HOST=mysql and REDIS_HOST=redis.
# Database user, password, and database name use DOCKER_DB_* (defaults match docker-compose.yml).
# DOCKER_DB_DATABASE=laravel
# DOCKER_DB_USERNAME=laravel
# DOCKER_DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_ENV="${APP_ENV}"
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# UI Kit Configuration
# ============================================================
UI_KIT_CSS=tailwind
UI_KIT_FRONTEND=blade
UI_KIT_ICONS=lucide
UI_KIT_DARK_MODE=true
UI_KIT_DARK_MODE_DEFAULT=system

# ============================================================
# IP Capture
# ============================================================
IP_CAPTURE_ENABLED=true
IP_CAPTURE_NULL_IP=0.0.0.0
IP_CAPTURE_TRUST_PROXIES=true
IP_CAPTURE_HASH=false

# ============================================================
# Captcha (Google reCAPTCHA)
# ============================================================
CAPTCHA_ENABLED=false
CAPTCHA_VERSION=v2
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_SCORE_THRESHOLD=0.5
CAPTCHA_SKIP_TESTING=true
CAPTCHA_SKIP_AUTHENTICATED=false

# ============================================================
# Profiles
# ============================================================
PROFILES_ENABLED=true
PROFILES_AVATAR_DISK=local
PROFILES_AVATAR_MAX_SIZE=1024
PROFILES_GRAVATAR_ENABLED=true
PROFILES_GRAVATAR_SIZE=80
PROFILES_GRAVATAR_SECURE=true
PROFILES_GOOGLE_MAPS_ENABLED=false
PROFILES_GOOGLE_MAPS_API_KEY=
PROFILES_ACCOUNT_DELETION_ENABLED=true
PROFILES_RESTORE_CUTOFF_DAYS=31
PROFILES_RESTORE_KEY=
PROFILES_DATA_EXPORT_ENABLED=true
PROFILES_MANAGE_SESSIONS=true

# ============================================================
# Socialite Kit
# ============================================================
SOCIALITE_KIT_ENABLED=true
SOCIALITE_KIT_DB_CREDENTIALS=false
SOCIALITE_KIT_AUTO_CREATE=true
SOCIALITE_KIT_REDIRECT=/home
SOCIALITE_GOOGLE_ENABLED=false
SOCIALITE_GITHUB_ENABLED=false
SOCIALITE_FACEBOOK_ENABLED=false
SOCIALITE_TWITTER_ENABLED=false

# ============================================================
# Themes
# ============================================================
THEMES_ENABLED=true
THEMES_DEFAULT=starter
THEMES_ALLOW_USER=true
THEMES_DARK_MODE=true

# ============================================================
# Toast Notifications
# ============================================================
TOAST_POSITION=top-right
TOAST_DURATION=5000
TOAST_MAX_VISIBLE=5
TOAST_BROADCAST_ENABLED=false

# ============================================================
# In-App Notifications
# ============================================================
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_PER_PAGE=20
NOTIFICATIONS_POLL_MS=30000

# ============================================================
# Chat (iMessage Style)
# ============================================================
CHAT_ENABLED=true
CHAT_MAX_LENGTH=5000
CHAT_READ_RECEIPTS=true
CHAT_REACTIONS=true
CHAT_BROADCAST_ENABLED=true
CHAT_PER_PAGE=50

# ============================================================
# Face Auth
# ============================================================
FACE_AUTH_ENABLED=false
FACE_AUTH_PRIMARY=false
FACE_AUTH_MFA=false
FACE_AUTH_LIVENESS=true
FACE_AUTH_MAX_FACES=3
FACE_AUTH_THRESHOLD=0.6

# ============================================================
# Observability
# ============================================================
OBSERVABILITY_ENABLED=true
SENTRY_ENABLED=false
SENTRY_LARAVEL_DSN=
BUGSNAG_ENABLED=false
DATADOG_ENABLED=false
FLARE_ENABLED=false

# ============================================================
# Auth API
# ============================================================
AUTH_API_ENABLED=true
AUTH_API_RATE_LIMIT=60
AUTH_API_REGISTER=true
AUTH_API_LOGIN=true
AUTH_API_FORGOT_PASSWORD=true

# ============================================================
# Native Kit (NativePHP)
# ============================================================
NATIVE_KIT_ENABLED=false
NATIVE_KIT_PLATFORM=electron

# ============================================================
# Existing Package Config (laravel-2step)
# ============================================================
LARAVEL_2STEP_ENABLED=false
LARAVEL_2STEP_DATABASE_CONNECTION=mysql
LARAVEL_2STEP_USER_MODEL=App\Models\User

# ============================================================
# Existing Package Config (laravel-logger)
# ============================================================
LARAVEL_LOGGER_DATABASE_CONNECTION=mysql
LARAVEL_LOGGER_ROLES_ENABLED=true
LARAVEL_LOGGER_MIDDLEWARE_ENABLED=true
LARAVEL_LOGGER_PAGINATION_ENABLED=true
LARAVEL_LOGGER_PAGINATION_PER_PAGE=25

# ============================================================
# Existing Package Config (laravel-blocker)
# ============================================================
LARAVEL_BLOCKER_DATABASE_CONNECTION=mysql
LARAVEL_BLOCKER_AUTH_ENABLED=true
LARAVEL_BLOCKER_ROLES_ENABLED=true

# ============================================================
# Existing Package Config (laravel-exception-notifier)
# ============================================================
EMAIL_EXCEPTION_ENABLED=false
EMAIL_EXCEPTION_FROM="${MAIL_FROM_ADDRESS}"
EMAIL_EXCEPTION_TO='email1@gmail.com'

# ============================================================
# Existing Package Config (laravel-roles)
# ============================================================
ROLES_DATABASE_CONNECTION=null
ROLES_GUI_ENABLED=true
ROLES_GUI_AUTH_ENABLED=true

# ============================================================
# Social Provider Credentials (used when DB credentials disabled)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Two-Step Verification
TWO_STEP_ENABLED=false

# Socialite Providers
FACEBOOK_ID=
FACEBOOK_SECRET=
FACEBOOK_REDIRECT="${APP_URL}/social/callback/facebook"

TWITTER_ID=
TWITTER_SECRET=
TWITTER_REDIRECT="${APP_URL}/social/callback/twitter"

GOOGLE_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT="${APP_URL}/social/callback/google"

GITHUB_ID=
GITHUB_SECRET=
GITHUB_REDIRECT="${APP_URL}/social/callback/github"
